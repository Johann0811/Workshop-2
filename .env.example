# Airflow Environment Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.8
AIRFLOW_UID=50000

# Admin Web UI Credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# MySQL Root Configuration
MYSQL_ROOT_PASSWORD=root_password

# MySQL Service Connection (internal to Docker network)
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Exposed Host Port for MySQL (for Notebooks and BI tools)
MYSQL_HOST_PORT=3307

# Databases and Users
AIRFLOW_DB_NAME=airflow_db
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=airflow_pass

GRAMMY_DB_NAME=grammy_source
GRAMMY_DB_USER=grammy_user
GRAMMY_DB_PASSWORD=grammy_pass

DW_DB_NAME=dw
DW_DB_USER=etl_user
DW_DB_PASSWORD=etl_pass
BI_DB_USER=bi_user
BI_DB_PASSWORD=bi_pass

# Pipeline Paths
DATA_DIR=/opt/airflow/data
WORK_DIR=/opt/airflow/data/work
OUTPUT_DIR=/opt/airflow/data/output
SPOTIFY_RAW_PATH=/opt/airflow/data/raw/spotify_dataset.csv
